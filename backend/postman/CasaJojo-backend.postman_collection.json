{
  "info": {
    "name": "CasaJojo Backend",
    "description": "Pruebas de los microservicios de CasaJojo (EP4 DSY1105). menu-service en el puerto 8081.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "menu-service",
      "item": [
        {
          "name": "1. Crear plato (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{menuUrl}}/api/menu",
              "host": [
                "{{menuUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            },
            "description": "Crea un plato. Guarda su id en la variable platoId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pollo asado\",\n  \"descripcion\": \"Incluye mix de ensaladas. Selecciona uno o dos agregados.\",\n  \"precio\": 4800,\n  \"disponible\": true,\n  \"imagenUri\": null,\n  \"fechaMenu\": \"2026-11-27\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.test(\"Devuelve id\", function () { pm.expect(j.id).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"platoId\", j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear plato para eliminar (POST)",
